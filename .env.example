# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  AcademiaHub — environment variables                                    ║
# ║                                                                         ║
# ║  Stack: Cloudflare Workers (frontend) · Render (backend) · Supabase DB  ║
# ║  Copy this file to .env for local Docker dev. Never commit .env.        ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Django ─────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-min-50-chars
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=academiadub.settings.local

# ── Database ────────────────────────────────────────────────────────────────
# LOCAL: uses the Postgres Docker container (db service in docker-compose.yml)
DATABASE_URL=postgres://academiadub:localpassword@db:5432/academiadub

# PRODUCTION (Render): paste your Supabase connection string
# Use the Transaction Pooler URL (port 6543) from:
#   Supabase Dashboard → Project Settings → Database → Connection string → URI
# Example:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# ── Redis ───────────────────────────────────────────────────────────────────
# LOCAL: Redis Docker container
REDIS_URL=redis://redis:6379/0
# PRODUCTION: Upstash Redis (free tier) — https://upstash.com
# REDIS_URL=rediss://:[password]@[host].upstash.io:6379

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@academiadub.in
# PRODUCTION: uncomment and fill in your SMTP provider (Resend / Brevo / SES)
# EMAIL_HOST=smtp.resend.com
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxx

# ── CORS / CSRF ──────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_COOKIE_DOMAIN=

# PRODUCTION:
# CORS_ALLOWED_ORIGINS=https://academiadub-web.workers.dev,https://academiadub.in
# CSRF_TRUSTED_ORIGINS=https://academiadub-api.onrender.com,https://academiadub.in
# AUTH_COOKIE_DOMAIN=.academiadub.in

# ── Next.js frontend ─────────────────────────────────────────────────────────
# LOCAL: Django dev server
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_INTERNAL_API_URL=http://api:8000

# PRODUCTION (set on Cloudflare dashboard / GitHub secret):
# NEXT_PUBLIC_API_URL=https://academiadub-api.onrender.com

# ── Postgres password (used by docker-compose db service) ───────────────────
POSTGRES_PASSWORD=localpassword

# ── Code runner ─────────────────────────────────────────────────────────────
CODE_RUNNER_SOCKET=/run/coderunner/runner.sock
CODE_RUNNER_TIMEOUT_SECONDS=5

# ── Feature flags ───────────────────────────────────────────────────────────
ENABLE_CODE_LAB=false
ENABLE_PAYMENTS=false
