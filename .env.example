# ── Django ─────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-min-50-chars
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=academiadub.settings.local

# ── Database ────────────────────────────────────────────────────────────────
# Add your server's MySQL credentials here. URL-encode special characters.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Email (console backend for local dev) ────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@academiadub.in

# ── AWS (leave blank for local dev — S3 calls will fail gracefully) ──────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_COOKIE_DOMAIN=

# ── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Code runner ─────────────────────────────────────────────────────────────
CODE_RUNNER_SOCKET=/run/coderunner/runner.sock
CODE_RUNNER_TIMEOUT_SECONDS=5

# ── Feature flags ───────────────────────────────────────────────────────────
ENABLE_CODE_LAB=false
ENABLE_PAYMENTS=false
