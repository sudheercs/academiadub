# ── Django ─────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-min-50-chars
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=academiadub.settings.local

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://academiadub:localpassword@db:5432/academiadub
POSTGRES_PASSWORD=localpassword

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Email (console backend for local dev) ────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@academiadub.in

# ── AWS (leave blank for local dev — S3 calls will fail gracefully) ──────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Code runner ─────────────────────────────────────────────────────────────
CODE_RUNNER_URL=http://coderunner:9000
CODE_RUNNER_TIMEOUT_SECONDS=5

# ── Feature flags ───────────────────────────────────────────────────────────
ENABLE_CODE_LAB=false
ENABLE_PAYMENTS=false
